    direction LR
    orders["orders"] {
        ID id PK
        ID buyer_user_id FK "optional"
        ID buyer_organization_id FK "optional"
        ID seller_of_record_party_id FK
        MONEY_PKR total_paisa
        FIELD state
        FIELD placed_at
    }
    order_items["order_items"] {
        ID id PK
        ID order_id FK
        ID product_id FK
        FIELD quantity
        MONEY_PKR unit_price_paisa
        FIELD terms_snapshot
        MONEY_PKR line_total_paisa
    }
    invoices["invoices"] {
        ID id PK
        ID order_id FK "optional"
        ID seller_party_id FK
        FIELD invoice_number
        MONEY_PKR total_paisa
        FIELD issued_at
        FIELD state
    }
    invoice_lines["invoice_lines"] {
        ID id PK
        ID invoice_id FK
        FIELD description
        FIELD quantity
        MONEY_PKR amount_paisa
    }
    payment_transactions["payment_transactions"] {
        ID id PK
        ID invoice_id FK "optional"
        FIELD provider_code
        FIELD provider_reference "optional"
        MONEY_PKR amount_paisa
        FIELD status
        FIELD initiated_at
    }
    payment_events["payment_events"] {
        ID id PK
        ID transaction_id FK
        FIELD provider_event_reference "optional"
        FIELD event_code
        FIELD payload_hash
        FIELD processed_at
    }
    refunds["refunds"] {
        ID id PK
        ID payment_transaction_id FK
        MONEY_PKR amount_paisa
        FIELD reason
        FIELD status
    }
    coupons["coupons"] {
        ID id PK
        FIELD code
        ID owner_party_id FK "optional"
        FIELD discount_rule
        FIELD valid_until "optional"
        FIELD usage_limit
    }
    coupon_redemptions["coupon_redemptions"] {
        ID id PK
        ID coupon_id FK
        ID order_id FK
        MONEY_PKR discount_paisa
    }
